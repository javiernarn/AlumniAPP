APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------
# Phase 6/7 — security hardening environment variables
# ------------------------------------------------------------------
# The SPA's real origin, used for the CORS allowlist and cookie scoping.
# Defaults to APP_URL if unset, which is correct for a same-origin
# deployment (Laravel serving the built frontend itself). Only needs
# setting explicitly if the frontend is deployed on a different origin
# than this API.
FRONTEND_URL="${APP_URL}"

# Set to true to have the app itself redirect plain-HTTP GET/HEAD
# requests to HTTPS. Read App\Http\Middleware\ForceHttps's class doc
# comment FIRST if your TLS is terminated by a reverse proxy/load
# balancer in front of Laravel — enabling this without also correctly
# configuring App\Http\Middleware\TrustProxies for your proxy will cause
# a redirect loop.
FORCE_HTTPS=false

# The Content-Security-Policy header ships in report-only mode by
# default (violations are reported to the browser console, nothing is
# blocked). Set to false only after validating the policy in
# app/Http/Middleware/SecurityHeaders.php against the real built
# frontend bundle — see PHASE_7_COMPLETION_REPORT.md.
CSP_REPORT_ONLY=true
